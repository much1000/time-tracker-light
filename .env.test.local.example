# Vorlage für .env.test.local (die echte Datei bleibt lokal und wird nie eingecheckt).
# Zugangsdaten eines eigenen Testkontos für die Browser-Tests (npm run test:e2e).
# Kopiere diese Datei nach .env.test.local und ersetze die Werte.
# Nimm ein eigenes Testkonto, nicht dein Konto mit echten Zeiten: Die Tests legen Daten an und löschen sie wieder.
TEST_USER_EMAIL=hier-testkonto-email
TEST_USER_PASSWORD=hier-testkonto-passwort